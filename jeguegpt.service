[Unit]
Description=JegueGPT Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bots/jeguegpt
Environment="SECOND_TELEGRAM_TOKEN="
ExecStart=/home/ubuntu/bots/jeguegpt/venv/bin/python /home/ubuntu/bots/jeguegpt/bot_openai_large.py
# Se você tiver .venv ao invés de venv, use:
# ExecStart=/home/ubuntu/bots/jeguegpt/.venv/bin/python /home/ubuntu/bots/jeguegpt/bot_openai_large.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jeguegpt

[Install]
WantedBy=multi-user.target
